function BookingModal({ open, onClose }: { open: boolean; onClose: () => void }) {
  const [name, setName]   = useState('');
  const [phone, setPhone] = useState('');
  const [date, setDate]   = useState('');
  const [time, setTime]   = useState('');
  const [loc, setLoc]     = useState<'estudio' | 'domicilio'>('estudio');
  const [sent, setSent]   = useState(false);

  const submit = (e: FormEvent) => {
    e.preventDefault();
    const msg = [`Hola, quisiera agendar una cita ✨`, '', `*Nombre:* ${name}`, `*Teléfono:* ${phone}`, `*Fecha:* ${date}`, `*Hora:* ${time}`, `*Modalidad:* ${loc === 'estudio' ? 'En el estudio' : 'A domicilio'}`].join('\n');
    window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`, '_blank');
    setSent(true);
    setTimeout(() => { setSent(false); onClose(); setName(''); setPhone(''); setDate(''); setTime(''); setLoc('estudio'); }, 1800);
  };

  const field = (label: string, Icon: typeof User, input: ReactNode) => (
    <div className="booking-field">
      <label className="booking-label"><Icon size={13} className="text-[hsl(var(--primary))]" />{label}</label>
      {input}
    </div>
  );

  return (
    <Dialog open={open} onOpenChange={v => { if (!v) onClose(); }}>
      <DialogContent className="booking-modal max-w-md w-full p-0 overflow-hidden border-0">
        <div className="booking-modal-header px-8 pt-8 pb-6">
          <DialogHeader>
            <div className="eyebrow mb-3 text-[hsl(var(--accent))]">Beauty Studio · Oaxaca</div>
            <DialogTitle className="font-display text-3xl font-medium leading-tight text-[hsl(var(--primary-foreground))]">
              Agenda tu<br /><em className="text-[hsl(var(--accent))]">cita.</em>
            </DialogTitle>
          </DialogHeader>
        </div>
        <form onSubmit={submit} className="px-8 pb-8 space-y-5">
          {field('Nombre completo', User,  <input required value={name}  onChange={e => setName(e.target.value)}  placeholder="Tu nombre"    className="booking-input" />)}
          {field('Teléfono',        Phone, <input required type="tel" value={phone} onChange={e => setPhone(e.target.value)} placeholder="951 000 0000" className="booking-input" />)}
          <div className="grid grid-cols-2 gap-3">
            {field('Fecha', CalendarDays, <input required type="date" value={date} onChange={e => setDate(e.target.value)} className="booking-input" />)}
            {field('Hora',  Clock3,       <input required type="time" value={time} onChange={e => setTime(e.target.value)} className="booking-input" />)}
          </div>
          <div className="booking-field">
            <label className="booking-label"><MapPin size={13} className="text-[hsl(var(--primary))]" />Modalidad</label>
            <div className="grid grid-cols-2 gap-2 mt-1">
              <button type="button" onClick={() => setLoc('estudio')}   className={`location-btn ${loc === 'estudio'   ? 'location-btn-active' : ''}`}><MapPin size={15} /> En el estudio</button>
              <button type="button" onClick={() => setLoc('domicilio')} className={`location-btn ${loc === 'domicilio' ? 'location-btn-active' : ''}`}><HomeIcon size={15} /> A domicilio</button>
            </div>
            {loc === 'domicilio' && <p className="mt-2 text-[11px] text-[hsl(var(--muted-foreground))] leading-5">* El servicio a domicilio tiene un costo extra según distancia y material.</p>}
          </div>
          <button type="submit" className="booking-submit w-full flex items-center justify-center gap-3">
            {sent ? <><Check size={16} /> Abriendo WhatsApp...</> : <><Send size={15} /> Enviar por WhatsApp</>}
          </button>
          <p className="text-center text-[11px] text-[hsl(var(--muted-foreground))] leading-5">Al dar clic se abrirá WhatsApp con tu información lista para enviar.</p>
        </form>
      </DialogContent>
    </Dialog>
  );
}

